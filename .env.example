# Copy this file to .env and fill in your values: cp .env.example .env
# Never commit your real .env file.

# --- Server ---
PORT=3000
NODE_ENV=development
# SQLite database file (created automatically)
DATABASE_PATH=./data/val-access.db
# Set to 1 when running behind a reverse proxy / PaaS (Render, Railway, Nginx) so rate limiting sees real client IPs
TRUST_PROXY=0
# Flat delivery fee in KES added to every order (0 = free / arranged on call)
DELIVERY_FEE_KES=0

# --- Admin ---
# Password for /admin (any username). Leave empty to disable the admin page.
ADMIN_PASSWORD=change-me-to-a-long-random-password

# --- M-Pesa (Safaricom Daraja) ---
# mock       = no real payments, simulated approvals (default, no credentials needed)
# sandbox    = Safaricom sandbox (https://developer.safaricom.co.ke test credentials)
# production = live payments
MPESA_MODE=mock
# Daraja app credentials (from your app on the Daraja portal)
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
# Business shortcode (Paybill number, or Head Office/Store number for a till). Sandbox: 174379
MPESA_SHORTCODE=
# Lipa Na M-Pesa Online passkey (sandbox passkey is shown on the Daraja simulator page)
MPESA_PASSKEY=
# CustomerPayBillOnline (Paybill) or CustomerBuyGoodsOnline (Till / Buy Goods)
MPESA_TRANSACTION_TYPE=CustomerPayBillOnline
# Receiving number. Leave empty for Paybill (uses MPESA_SHORTCODE); set to your Till number for Buy Goods
MPESA_PARTY_B=
# Optional fixed account reference shown to the customer (max 12 chars). Default: the order code
MPESA_ACCOUNT_REFERENCE=
# Public HTTPS URL of this app - Safaricom sends payment results to PUBLIC_BASE_URL/api/mpesa/callback/<secret>
PUBLIC_BASE_URL=
# Long random string used in the callback URL so nobody else can fake payment results (min 16 chars)
# Generate one with: node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
MPESA_CALLBACK_SECRET=
# Mock mode only: how long (ms) before a simulated payment completes
MPESA_MOCK_DELAY_MS=4000
